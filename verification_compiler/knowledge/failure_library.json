{
  "schema": "verification-compiler/failure-library/1",
  "note": "Curated incident structures in CTD's core vocabulary. Every case is validated with the strict kernel gate in tests/test_discovery.py. Projections from these cases are HYPOTHESES with checks, never facts.",
  "cases": [
    {
      "id": "case:retry-storm",
      "domain": "distributed-systems",
      "text": "Clients retried a slow backend without backoff; the extra load kept it saturated long after the original fault cleared.",
      "relations": [
        {
          "pred": "DEPENDS",
          "args": [
            "client",
            "backend"
          ]
        },
        {
          "pred": "CAUSES",
          "args": [
            {
              "pred": "RETRIES",
              "args": [
                "client",
                "backend"
              ]
            },
            {
              "pred": "INCREASES",
              "args": [
                "retry_load",
                "backend_pressure"
              ]
            }
          ]
        },
        {
          "pred": "SATURATES",
          "args": [
            "backend"
          ]
        }
      ],
      "types": {
        "client": "SERVICE",
        "backend": "RESOURCE",
        "retry_load": "LOAD",
        "backend_pressure": "SIGNAL"
      },
      "severity": 4,
      "check_templates": {
        "SATURATES": "Make {0} slow or failing and measure how many requests it receives per original request; retries must be bounded with backoff and jitter."
      }
    },
    {
      "id": "case:pool-exhaustion",
      "domain": "retail-banking",
      "text": "Tellers held branch database connections while waiting on a slow credit bureau; the pool ran dry and every counter stalled.",
