              ]
            },
            {
              "pred": "EXHAUSTS",
              "args": [
                "teller",
                "branch_db_pool"
              ]
            }
          ]
        }
      ],
      "types": {
        "teller": "SERVICE",
        "branch_db_pool": "POOL",
        "credit_bureau": "RESOURCE"
      },
      "severity": 4,
      "check_templates": {
        "EXHAUSTS": "Make the slow dependency hang while sending concurrent requests; verify connections from {1} are released and calls time out instead of queueing."
      }
    },
    {
